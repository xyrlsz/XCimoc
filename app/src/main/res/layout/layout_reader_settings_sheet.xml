<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读器快捷设置面板（底部上滑弹出） -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <!-- 拖拽手柄 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_reader_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/reader_settings_sheet_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 阅读方向 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_reader_turn"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/reader_turn_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_turn_ltr"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_turn_rtl"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_turn_atb"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 屏幕方向 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_reader_orientation"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/reader_orientation_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_orientation_portrait"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_orientation_landscape"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_orientation_auto"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 阅读模式 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reader_settings_mode"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/reader_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_mode_page"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_mode_stream"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 开关设置 -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_night"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/drawer_night" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_white_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reader_white_background" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_keep_bright"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reader_keep_bright" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_hide_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reader_hide_info" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_volume_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reader_volume_key_controls" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_dual_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reader_dual_page" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_dual_page_rtl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reader_dual_page_rtl" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reader_switch_dual_page_no_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_reader_dual_page_no_gap" />

    <!-- 完整设置入口 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reader_settings_full"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reader_settings_full" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
