<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 深色模式不使用纯黑：窗口 / 卡片表面统一走自适应色 -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorBackgroundTrans">@color/colorBackgroundTrans</item>
        <item name="colorAutoWG">@color/colorAutoWG</item>
        <item name="colorAutoG_GW">@color/colorAutoG_GW</item>
        <item name="colorAutoBG">@color/colorAutoBG</item>
        <item name="colorAutoBW">@color/colorAutoBW</item>
        <item name="colorAutoWB">@color/colorAutoWB</item>
        <item name="materialButtonStyle">@style/Widget.MyApp.MaterialButton</item>

    </style>

    <style name="Widget.MyApp.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorAccent</item>
    </style>

    <!-- 溢出菜单 / 下拉弹窗：跟随应用表面色，避免深色模式下弹出 AppCompat 默认的 #303030 面板 -->
    <style name="ThemeOverlay.AppTheme.Popup" parent="ThemeOverlay.AppCompat.DayNight">
        <item name="android:colorBackground">@color/colorSurface</item>
    </style>

    <!-- 阅读器快捷设置面板：描边按钮（边框颜色按明暗模式自适应，深色下更亮） -->
    <style name="Widget.MyApp.MaterialButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/reader_outline</item>
    </style>

    <style name="AppThemeNoDark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!--        // 防止miui及其他魔改ROM启用反色-->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/colorPrimaryOrange</item>
        <item name="colorPrimaryDark">@color/colorPrimaryOrangeDark</item>
        <item name="colorAccent">@color/colorPrimaryOrangeDark</item>
        <item name="colorSecondary">@color/colorPrimaryOrangeDark</item>
        <item name="materialButtonStyle">@style/Widget.MyApp.MaterialButton</item>

    </style>

    <!-- 阅读器快捷设置面板：浅色主题（阅读器 Activity 强制浅色，需单独指定） -->
    <style name="ReaderBottomSheetLight" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">#8A000000</item>
        <item name="colorPrimary">@color/colorPrimaryOrange</item>
        <item name="colorPrimaryDark">@color/colorPrimaryOrangeDark</item>
        <item name="colorAccent">@color/colorPrimaryOrangeDark</item>
        <item name="colorSecondary">@color/colorPrimaryOrangeDark</item>
    </style>

    <!-- 阅读器快捷设置面板：深色主题（适配夜间模式） -->
    <style name="ReaderBottomSheetDark" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorPrimary">@color/colorPrimaryOrange</item>
        <item name="colorPrimaryDark">@color/colorPrimaryOrangeDark</item>
        <item name="colorAccent">@color/colorPrimaryOrangeDark</item>
        <item name="colorSecondary">@color/colorPrimaryOrangeDark</item>
        <!-- 深色模式下默认 colorOutline 太暗，描边按钮边框看不清，单独指定更亮的描边色 -->
        <item name="materialButtonOutlinedStyle">@style/Widget.MyApp.MaterialButton.Outlined</item>
    </style>

    <style name="AppThemeBlue" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryBlue</item>
        <item name="colorPrimaryDark">@color/colorPrimaryBlueDark</item>
        <item name="colorAccent">@color/colorPrimaryBlueDark</item>
        <item name="colorSecondary">@color/colorPrimaryBlueDark</item>
        <item name="alertDialogTheme">@style/DialogThemeBlue</item>
    </style>

    <!-- 对话框窗口宽度：竖屏按屏幕宽度比例；横屏改用固定宽度，见 values-land/styles.xml -->
    <style name="DialogWindowSize" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="BaseDialogTheme" parent="DialogWindowSize">
        <!-- 统一对话框外观：圆角卡片与留白（窗口宽度见 DialogWindowSize） -->
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>

    <style name="DialogThemeBlue" parent="BaseDialogTheme">
        <item name="colorPrimary">@color/colorPrimaryBlue</item>
        <item name="colorAccent">@color/colorPrimaryBlueDark</item>
        <item name="colorSecondary">@color/colorPrimaryBlueDark</item>
    </style>

    <style name="AppThemeGrey" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryGrey</item>
        <item name="colorPrimaryDark">@color/colorPrimaryGreyDark</item>
        <item name="colorAccent">@color/colorPrimaryGreyDark</item>
        <item name="colorSecondary">@color/colorPrimaryGreyDark</item>
        <item name="alertDialogTheme">@style/DialogThemeGrey</item>
    </style>

    <style name="DialogThemeGrey" parent="BaseDialogTheme">
        <item name="colorPrimary">@color/colorPrimaryGrey</item>
        <item name="colorAccent">@color/colorPrimaryGreyDark</item>
        <item name="colorSecondary">@color/colorPrimaryGreyDark</item>
    </style>

    <style name="AppThemeTeal" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryTeal</item>
        <item name="colorPrimaryDark">@color/colorPrimaryTealDark</item>
        <item name="colorAccent">@color/colorPrimaryTealDark</item>
        <item name="colorSecondary">@color/colorPrimaryTealDark</item>
        <item name="alertDialogTheme">@style/DialogThemeTeal</item>
    </style>

    <style name="DialogThemeTeal" parent="BaseDialogTheme">
        <item name="colorPrimary">@color/colorPrimaryTeal</item>
        <item name="colorAccent">@color/colorPrimaryTealDark</item>
        <item name="colorSecondary">@color/colorPrimaryTealDark</item>
    </style>

    <style name="AppThemePurple" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryPurple</item>
        <item name="colorPrimaryDark">@color/colorPrimaryPurpleDark</item>
        <item name="colorAccent">@color/colorPrimaryPurpleDark</item>
        <item name="colorSecondary">@color/colorPrimaryPurpleDark</item>
        <item name="alertDialogTheme">@style/DialogThemePurple</item>
    </style>

    <style name="DialogThemePurple" parent="BaseDialogTheme">
        <item name="colorPrimary">@color/colorPrimaryPurple</item>
        <item name="colorAccent">@color/colorPrimaryPurpleDark</item>
        <item name="colorSecondary">@color/colorPrimaryPurpleDark</item>
    </style>

    <style name="AppThemePink" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryPink</item>
        <item name="colorPrimaryDark">@color/colorPrimaryPinkDark</item>
        <item name="colorAccent">@color/colorPrimaryPinkDark</item>
        <item name="colorSecondary">@color/colorPrimaryPinkDark</item>
        <item name="alertDialogTheme">@style/DialogThemePink</item>
    </style>

    <style name="DialogThemePink" parent="BaseDialogTheme">
        <item name="colorPrimary">@color/colorPrimaryPink</item>
        <item name="colorAccent">@color/colorPrimaryPinkDark</item>
        <item name="colorSecondary">@color/colorPrimaryPinkDark</item>
    </style>

    <style name="AppThemeBrown" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryBrown</item>
        <item name="colorPrimaryDark">@color/colorPrimaryBrownDark</item>
        <item name="colorAccent">@color/colorPrimaryBrownDark</item>
        <item name="colorSecondary">@color/colorPrimaryBrownDark</item>
        <item name="alertDialogTheme">@style/DialogThemeBrown</item>
    </style>

    <style name="DialogThemeBrown" parent="BaseDialogTheme">
        <item name="colorPrimary">@color/colorPrimaryBrown</item>
        <item name="colorAccent">@color/colorPrimaryBrownDark</item>
        <item name="colorSecondary">@color/colorPrimaryBrownDark</item>
    </style>

    <style name="AppThemeOrange" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryOrange</item>
        <item name="colorPrimaryDark">@color/colorPrimaryOrangeDark</item>
        <item name="colorAccent">@color/colorPrimaryOrangeDark</item>
        <item name="colorSecondary">@color/colorPrimaryOrangeDark</item>
        <item name="alertDialogTheme">@style/DialogThemeOrange</item>
    </style>

    <style name="DialogThemeOrange" parent="BaseDialogTheme">
        <item name="colorPrimary">@color/colorPrimaryOrange</item>
        <item name="colorAccent">@color/colorPrimaryOrangeDark</item>
        <item name="colorSecondary">@color/colorPrimaryOrangeDark</item>
    </style>
    <style name="SliderTooltip" parent="Widget.MaterialComponents.Tooltip">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="shapeAppearanceOverlay">@style/TooltipShapeOverlay</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TooltipShapeOverlay">
        <item name="cornerSize">50%</item>
        <item name="cornerFamily">rounded</item>
    </style>
</resources>
